# SnapTrade Personal API key — https://dashboard.snaptrade.com/api-key (dashboard requires 2FA)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# E*Trade direct (optional; instead of or alongside SnapTrade). Developer key from
# https://developer.etrade.com — tied to your own E*Trade login. Access tokens
# expire at midnight Eastern every day; the connect skill walks you through re-auth.
# ETRADE_CONSUMER_KEY=
# ETRADE_CONSUMER_SECRET=
# ETRADE_SANDBOX=1          # send API calls to apisb.etrade.com (fake accounts)
# Required only for the fundamental-research and stock-screener skills:
# the SEC requires a User-Agent with a contact address on every EDGAR request
# and blocks anonymous or placeholder clients with HTTP 403.
# EDGAR_USER_AGENT="my-app-name me@example.com"   # quote values that contain spaces (unquoted also parses)
# Optional: declare account types so the trading skill can warn on unsettled cash.
# Unknown accounts are treated as cash (the conservative default).
# <account_id> is the SnapTrade account UUID shown as "account_id" by
#   skills/portfolio-analysis/scripts/accounts.py (or connect/scripts/status.py),
#   not your brokerage account number. Only margin accounts need an entry.
# BROKER_ACCOUNT_TYPES=<account_id>=cash,<account_id>=margin
# SNAPTRADE_ACCOUNT_TYPES is still accepted. E*Trade accounts report their mode themselves.
